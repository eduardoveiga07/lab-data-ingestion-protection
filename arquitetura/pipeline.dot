digraph Pipeline {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.5",
    nodesep="0.55",
    ranksep="0.70",
    fontname="Arial",
    labelloc="t",
    label="Do dado à proteção — arquitetura do laboratório",
    fontsize=22,
    splines=ortho
  ];
  node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#506176",
        fontname="Arial", fontsize=10, margin="0.18,0.10"];
  edge [color="#58677A", fontname="Arial", fontsize=9, arrowsize=0.75];

  /* ─── FLUXO PRINCIPAL (rank forçado) ─── */
  { rank=same; csv; }
  { rank=same; origem; pub; }
  { rank=same; cdc; leitores; }
  { rank=same; bronze; }
  { rank=same; silver; chave; }
  { rank=same; gold; }
  { rank=same; consumo; }

  csv    [label="CSV sintéticos\nDia 1 / Dia 3"];
  origem [label="Origem SQLite\nclientes · pedidos · navegação", fillcolor="#E5EEF9"];
  cdc    [label="CDC por gatilhos\ntabela mudancas"];
  pub    [label="Produtor de navegação\nlog append-only"];
  leitores [label="Leitores independentes\nvisitas · bronze · por_cliente"];
  bronze [label="Bronze\ndados brutos + offsets + quarentena", fillcolor="#FFF1D6"];
  silver [label="Silver\npseudônimos + campos minimizados", fillcolor="#E1F4E8"];
  gold   [label="Gold\nagregados com limiar K=2", fillcolor="#E9E2FA"];
  consumo [label="Consumo analítico\nreceita por cidade / resumo", shape=note, fillcolor="#F6F2FF"];

  chave [label="CHAVE_PSEUDONIMO\nvariável de ambiente / cofre externo\nnunca no repositório",
         fillcolor="#FDE8EF", color="#B80F45", fontsize=9];

  /* fluxo de dados principal */
  csv     -> origem  [label="carga inicial"];
  origem  -> cdc     [label="INSERT / UPDATE / DELETE"];
  origem  -> pub     [label="eventos de navegação"];
  pub     -> leitores [label="log + offsets"];
  cdc     -> bronze  [label="sincronização CDC"];
  leitores -> bronze [label="eventos"];
  bronze  -> silver  [label="contratos + HMAC"];
  silver  -> gold    [label="agregação / supressão"];
  gold    -> consumo;
  chave   -> silver  [label="HMAC", color="#B80F45", style=dashed];

  /* ─── CONTROLES TRANSVERSAIS (bloco separado à direita) ─── */
  subgraph cluster_controles {
    label="Controles transversais";
    color="#AAB8C8"; style="rounded,dashed"; fontname="Arial";
    fontsize=13; labeljust="l";

    gov    [label="Governança\ncontratos · catálogo · retenção"];
    classes [label="Classificação das camadas\nOrigem / CDC / Bronze: pessoal\nSilver: pseudonimizada (ainda pessoal)\nGold: agregada, supressão K=2", fillcolor="#F3F6FA"];
    acesso [label="Acesso por função (modelo lógico)\nIngestão: origem / Bronze\nAnalista: Silver / Gold\nRestrito: chave e backups"];
    priv   [label="Privacidade\ngeneralização · K-anonimato"];
    copias [label="Cópias e retenção\nsnapshot local + manifesto SHA-256\noff-site / imutabilidade: não implementados", fillcolor="#FFF1D6"];
    del    [label="Direito ao esquecimento\nledger externo à cópia", fillcolor="#FDE8EF", color="#B80F45"];
    backup [label="Resiliência\nsnapshot + SHA-256"];
    restore [label="Restauração\nvalidar → reaplicar exclusões\n→ reconstruir Silver / Gold", fillcolor="#E1F4E8"];
  }

  /* setas dos controles → camadas (agrupadas, sem cruzamentos) */
  gov    -> bronze  [style=dashed, arrowhead=none, color="#AAB8C8"];
  gov    -> silver  [style=dashed, arrowhead=none, color="#AAB8C8"];
  classes -> bronze [style=dashed, arrowhead=none, color="#AAB8C8"];
  classes -> silver [style=dashed, arrowhead=none, color="#AAB8C8"];
  classes -> gold   [style=dashed, arrowhead=none, color="#AAB8C8"];
  acesso -> bronze  [style=dashed, arrowhead=none, color="#AAB8C8"];
  acesso -> silver  [style=dashed, arrowhead=none, color="#AAB8C8"];
  priv   -> gold    [style=dashed, arrowhead=none, color="#AAB8C8"];
  copias -> backup  [style=dashed, arrowhead=none, color="#AAB8C8"];

  del -> origem  [style=dashed, label="eliminação",    color="#B80F45"];
  del -> bronze  [style=dashed, label="limpeza/ledger", color="#B80F45"];
  del -> restore [label="replay da lista",             color="#B80F45", style=dashed];

  origem -> backup [style=dashed, label="snapshot", color="#777"];
  bronze -> backup [style=dashed, color="#777"];
  silver -> backup [style=dashed, color="#777"];
  gold   -> backup [style=dashed, color="#777"];

  backup  -> restore [label="manifesto + bancos"];
  restore -> silver  [label="reconstrução", color="#0A7D3F", constraint=false];
  restore -> gold    [label="reconstrução", color="#0A7D3F", constraint=false];
}
