digraph VidaDoDado {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.5",
    nodesep="0.60",
    ranksep="0.65",
    fontname="Arial",
    labelloc="t",
    label="Vida de um dado pessoal — do cadastro à eliminação",
    fontsize=22,
    splines=ortho
  ];
  node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#506176",
        fontname="Arial", fontsize=10, margin="0.18,0.10"];
  edge [color="#58677A", fontname="Arial", fontsize=9, arrowsize=0.75];

  /* ──── COLUNA CENTRAL: fluxo do dado ──── */
  { rank=source;  titular; }
  { rank=same;    origem; solicitacao; }
  { rank=same;    cdc;    ledger; }
  { rank=same;    bronze; }
  { rank=same;    silver; backup; }
  { rank=same;    gold; }
  { rank=same;    consumo; limpar; }
  { rank=same;    restore; }
  { rank=sink;    final; }

  titular [label="Titular / cadastro sintético", fillcolor="#FDE8EF"];
  origem  [label="Origem SQLite\nclientes: nome, e-mail, CPF, nascimento, cidade", fillcolor="#FDE8EF"];
  cdc     [label="Log CDC / mudanças\npayload pessoal enquanto necessário", fillcolor="#FFF1D6"];
  bronze  [label="Bronze\ncópia bruta + lote + quarentena", fillcolor="#FFF1D6"];
  silver  [label="Silver\nHMAC cliente_ps + faixa etária + cidade\nsem CPF, nome, e-mail ou texto livre", fillcolor="#E1F4E8"];
  gold    [label="Gold\nreceita por cidade e métricas agregadas\nsupressão de grupos com K < 2", fillcolor="#E9E2FA"];
  consumo [label="Consumo analítico autorizado\nsem identificadores diretos", shape=note, fillcolor="#F6F2FF"];

  /* ──── COLUNA DIREITA: eliminação ──── */
  solicitacao [label="Solicitação de eliminação\ncliente de teste 5", fillcolor="#FDE8EF", color="#B80F45"];
  ledger  [label="Lista de eliminação externa ao snapshot\nchave derivada + data + moradas tratadas\nsem identificadores diretos", fillcolor="#FDE8EF", color="#B80F45"];
  limpar  [label="Expurgo / desvinculação\norigem, CDC, Bronze e Silver\nlimpar texto livre e eventos identificáveis", fillcolor="#FDE8EF", color="#B80F45"];

  /* ──── COLUNA ESQUERDA: backup / restauração ──── */
  backup  [label="Backups locais\nmanifesto SHA-256\nretenção/expiração documentada", fillcolor="#FFF1D6"];
  restore [label="Restauração\nvalidar integridade → reaplicar ledger\n→ reconstruir Silver e Gold", fillcolor="#E1F4E8"];
  final   [label="Verificação pós-eliminação\ncliente não reaparece; pedido 106 fica pago\nmas sem vínculo pessoal", fillcolor="#E7F5EC", color="#0A7D3F"];

  /* ── fluxo principal do dado (azul) ── */
  titular -> origem  [label="cadastro"];
  origem  -> cdc     [label="INSERT / UPDATE / DELETE", color="#0B6BCB"];
  origem  -> bronze  [label="carga inicial / incremental",  color="#0B6BCB"];
  cdc     -> bronze  [label="replay ordenado",              color="#0B6BCB"];
  bronze  -> silver  [label="contrato + minimização + HMAC", color="#0A7D3F"];
  silver  -> gold    [label="generalização + agregação",     color="#0A7D3F"];
  gold    -> consumo;

  /* ── backup (cinza tracejado) ── */
  origem  -> backup [style=dashed, label="snapshot", color="#888"];
  bronze  -> backup [style=dashed, color="#888"];
  silver  -> backup [style=dashed, color="#888"];
  gold    -> backup [style=dashed, color="#888"];
  backup  -> restore [label="se recuperação necessária"];

  /* ── eliminação (vermelho) ── */
  solicitacao -> ledger  [label="registrar pedido",         color="#B80F45"];
  solicitacao -> limpar  [label="executar esquecimento",     color="#B80F45"];
  ledger      -> limpar  [label="idempotência / trilha",     color="#B80F45"];
  ledger      -> restore [label="replay obrigatório",        color="#B80F45"];

  limpar -> origem  [label="apagar / desvincular",                       color="#B80F45", constraint=false];
  limpar -> cdc     [label="expurgar payload; manter tombstone mínimo",  color="#B80F45", constraint=false];
  limpar -> bronze  [label="limpar cópias",                              color="#B80F45", constraint=false];
  limpar -> silver  [label="remover pseudônimo/eventos",                 color="#B80F45", constraint=false];
  limpar -> final   [label="validar ausência",                           color="#0A7D3F"];

  restore -> final  [label="não ressuscitar dados", color="#0A7D3F"];
}
